# Local Docker MySQL. For an external hosted database, set DB_HOST/DB_PORT and credentials.
DB_USER=root
DB_PASSWORD=campuscommons-local
DB_NAME=campus_tracker
DB_HOST=mysql
DB_PORT=3306
MYSQL_PORT=3307
API_BIND_ADDRESS=127.0.0.1
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Browser URL used by the backend CORS allowlist.
CORS_ORIGIN=http://localhost:3000
# Optional; when unset, the app uses same-origin /api and /ws Vite proxies.
VITE_API_URL=
