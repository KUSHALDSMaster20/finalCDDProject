# MySQL connection values used by docker compose for XAMPP on this computer.
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_tracker
JWT_SECRET=replace-this-with-a-long-random-secret
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Browser URL used by the backend CORS allowlist.
CORS_ORIGIN=http://localhost:3000
# Optional; when unset, the app uses same-origin /api and /ws Vite proxies.
VITE_API_URL=
